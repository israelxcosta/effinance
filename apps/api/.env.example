NODE_ENV=development
PORT=3333
HOST=0.0.0.0
# Proxy hops whose X-Forwarded-For is trusted (1 = the load balancer in front of the API)
TRUST_PROXY=1

# PostgreSQL. In production connect as the app login user (member of effinance_app, see
# docs/deploy-aws.md) with TLS: DATABASE_SSL=verify-full and the RDS CA bundle.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/effinance
DATABASE_SSL=disable
# DATABASE_CA_FILE=/etc/ssl/rds/global-bundle.pem

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret-of-32-chars-or-more
# Comma-separated list of allowed browser origins (CORS + CSRF origin check)
CORS_ORIGIN=http://localhost:5173
# Public URL of the web app (e-mail links, checkout return URL)
APP_URL=http://localhost:5173
LOG_LEVEL=info

# Envelope encryption of sensitive fields (one data key per workspace).
#  local: master key in this variable — generate with
#         node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#  aws:   AWS KMS customer managed key (recommended in production)
KEY_PROVIDER=local
ENCRYPTION_MASTER_KEY=
# KMS_KEY_ID=arn:aws:kms:sa-east-1:123456789012:key/...
# AWS_REGION=sa-east-1

# E-mail: console (logs), webhook (POST JSON to MAIL_WEBHOOK_URL) or ses (Amazon SES v2)
MAILER=console
MAIL_FROM=Effinance <nao-responda@effinance.app>
# MAIL_WEBHOOK_URL=https://...
# MAIL_WEBHOOK_SECRET=

# Billing: fake (dev/demo, POST /billing/dev/activate) or mercadopago
BILLING_PROVIDER=fake
# MP_ACCESS_TOKEN=APP_USR-...
# MP_WEBHOOK_SECRET=  (Suas integrações → Webhooks → Assinatura secreta)

# Shared rate-limit store for multiple API instances (optional)
# REDIS_URL=redis://localhost:6379
